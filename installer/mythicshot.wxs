<?xml version="1.0" encoding="utf-8"?>
<!--
  Mythicshot installer (WiX v5). Per-user: installs to
  %LocalAppData%\Programs\Mythicshot without an admin prompt, adds a Start
  menu shortcut and an entry in Settings › Apps for uninstalling. The wizard
  (ui.wxs) can also start Mythicshot at sign-in and run it when setup ends.
  Build, from installer\:
  wix build mythicshot.wxs ui.wxs -ext WixToolset.UI.wixext -arch x64 -d Version=0.1.1 -d Exe=<path to mythicshot.exe> -o ..\dist\Mythicshot-0.1.1-x64.msi
  Silent install without start at sign-in or taking Print Screen: msiexec /i Mythicshot-0.1.1-x64.msi /qn AUTOSTART=0 TAKEPRTSC=0
  The app's own update runs: msiexec /i <installer> /passive /norestart MYTHICSHOT_RELAUNCH=1
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Mythicshot"
           Manufacturer="Mythicshot, LLC"
           Version="$(Version)"
           UpgradeCode="41EFFDDF-DEBA-4B83-A653-893B2EF06D69"
           Scope="perUser"
           Compressed="yes">
    <SummaryInformation Description="Mythicshot: screenshots, recordings and tours" />

    <!-- Installing this or a newer version replaces the old one. The old version is removed inside
         the install's own transaction, so an install that fails or is cancelled puts it back as it was. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" Schedule="afterInstallInitialize" DowngradeErrorMessage="A newer version of Mythicshot is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="MythicshotIcon" SourceFile="..\assets\mythicshot.ico" />
    <Property Id="ARPPRODUCTICON" Value="MythicshotIcon" />
    <Property Id="ARPHELPLINK" Value="https://www.gnu.org/licenses/agpl-3.0.html" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <!-- Wizard options, both on by default. A cleared checkbox deletes its property. -->
    <Property Id="AUTOSTART" Value="1" Secure="yes" />
    <Property Id="LAUNCHAPP" Value="1" Secure="yes" />
    <Property Id="TAKEPRTSC" Value="1" Secure="yes" />

    <!--
      Print Screen: Windows 11 gives the key to Snipping Tool by default. Install
      turns that off (if ticked); a real uninstall, not an upgrade, asks whether
      to turn it back on. Both steps are mythicshot.exe itself, so the logic is
      in platform.rs. The question is skipped for silent uninstalls.
    -->
    <CustomAction Id="TakePrintScreen" FileRef="MythicshotExe" ExeCommand="--installer prtsc-off" Execute="deferred" Impersonate="yes" Return="ignore" />
    <CustomAction Id="AskPrintScreen" FileRef="MythicshotExe" ExeCommand="--installer prtsc-ask" Execute="immediate" Return="ignore" />
    <!--
      An update started from the app (MYTHICSHOT_RELAUNCH=1, which only the app passes) opens
      Mythicshot again once the install has succeeded: the action comes after InstallFinalize, so
      an install that failed, was cancelled or rolled back never gets there. It starts the program
      and does not wait for it; nothing is left running. A plain install never sets the property,
      so it behaves as before.
    -->
    <Property Id="MYTHICSHOT_RELAUNCH" Secure="yes" />
    <CustomAction Id="RelaunchAfterUpdate" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]mythicshot.exe&quot;" Return="asyncNoWait" />
    <InstallExecuteSequence>
      <Custom Action="RelaunchAfterUpdate" After="InstallFinalize" Condition="MYTHICSHOT_RELAUNCH = 1 AND NOT REMOVE" />
      <Custom Action="TakePrintScreen" After="InstallFiles" Condition="TAKEPRTSC = 1 AND NOT REMOVE" />
      <Custom Action="AskPrintScreen" After="InstallInitialize" Condition="REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND UILevel &gt; 2" />
    </InstallExecuteSequence>

    <UIRef Id="MythicshotUI" />
    <WixVariable Id="WixUIBannerBmp" Value="images/banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="images/dialog.bmp" />
    <SetProperty Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="Mythicshot is installed. Find it in the Start menu; while it runs it sits in the notification area. Press PrtSc to take a screenshot." Before="CostFinalize" Sequence="ui" Condition="NOT Installed" />
    <CustomAction Id="LaunchApplication" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]mythicshot.exe&quot;" Return="asyncNoWait" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Mythicshot" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- Per-user components use a registry value as their key path, as Windows Installer expects. -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="MainExe" Guid="D6C760D4-E8E1-4502-BB2E-65853E41E6F4">
        <File Id="MythicshotExe" Source="$(Exe)" Name="mythicshot.exe" />
        <File Id="LicenseFile" Source="..\LICENSE" Name="LICENSE.txt" />
        <!-- The licences of the fonts: Manrope, and Hack, Ubuntu-Light and egui's icon glyphs (which egui
             builds in), are in mythicshot.exe; Cinzel sets the name in the wizard's side picture. -->
        <File Id="ManropeLicense" Source="..\assets\fonts\manrope\OFL.txt" Name="OFL-Manrope.txt" />
        <File Id="CinzelLicense" Source="..\assets\fonts\cinzel\OFL.txt" Name="OFL-Cinzel.txt" />
        <File Id="HackLicense" Source="..\assets\fonts\egui\Hack-LICENSE.txt" Name="LICENSE-Hack.txt" />
        <File Id="UbuntuLicense" Source="..\assets\fonts\egui\UFL.txt" Name="UFL-Ubuntu.txt" />
        <File Id="EmojiIconLicense" Source="..\assets\fonts\egui\emoji-icon-font-LICENSE.txt" Name="LICENSE-emoji-icon-font.txt" />
        <File Id="ReadmeFile" Source="..\README.md" Name="README.md" />
        <RegistryValue Root="HKCU" Key="Software\Mythicshot" Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
        <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
      </Component>
      <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder" Guid="7F64D9FB-8823-4244-B7E2-F8CC91A8E17D">
        <Shortcut Id="MythicshotShortcut"
                  Name="Mythicshot"
                  Description="Mythicshot: screenshots, recordings and tours"
                  Target="[INSTALLFOLDER]mythicshot.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="MythicshotIcon" />
        <RegistryValue Root="HKCU" Key="Software\Mythicshot" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <!-- The same Run entry the app's "Start Mythicshot when I sign in" setting writes, so either can turn it off. -->
      <Component Id="Autostart" Guid="C7F2AE15-D64E-43CF-B660-586F0DFB8F72" Condition="AUTOSTART = 1">
        <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="Mythicshot" Type="string" Value="&quot;[INSTALLFOLDER]mythicshot.exe&quot;" />
        <RegistryValue Root="HKCU" Key="Software\Mythicshot" Name="AutostartAtInstall" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="Mythicshot">
      <ComponentGroupRef Id="AppFiles" />
    </Feature>
  </Package>
</Wix>
